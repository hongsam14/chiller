# Local development credentials for the compose stack.
#
#   make dev-env      # generates deploy/compose/.env with a fresh random key
#   -- or --
#   cp .env.example .env && $EDITOR .env
#
# .env is gitignored. This file deliberately contains NO key material, not even a
# throwaway one: a secret scanner cannot tell a harmless placeholder from a
# production key, and it must not be taught to — that judgment is exactly how real
# keys get committed. So there is nothing here for it to find.
#
# In production these come from a secret store (sealed-secrets, Vault), never from
# a file in this repository. See deploy/k8s/secret.example.yaml.

# Bearer token for the ScanAPI (SECURITY-08: an empty token denies all).
CHILLER_TOKEN=

# AES-256-GCM key sealing evidence and cached response bodies: 32 bytes, base64.
#   openssl rand -base64 32
# A lone un-prefixed key is "k1". To rotate, name every entry:
#   CHILLER_EVIDENCE_KEY="k2:<new>,k1:<old>"
# The first seals new values; the rest stay available to open existing ones.
CHILLER_EVIDENCE_KEY=
